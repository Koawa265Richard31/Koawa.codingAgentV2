{
 "config_schema_version": 3,
 "repo": "D:/A_Dev_Projects/KoawaAgent/v2",
 "db": "state.sqlite3",
 "provider": {
  "base_url": "https://api.siliconflow.cn/v1",
  "api_key_env": "SF_CodingAgentTestKey",
  "model": "deepseek-ai/DeepSeek-V4-Flash",
  "provider": "siliconflow",
  "timeout_seconds": 120,
  "max_stream_seconds": 600,
  "max_output_tokens": 16384
 },
 "sandbox": {
  "runner": "host"
 },
 "test_profiles": [
  {
   "profile_id": "python_unittest",
   "argv": [
    "C:/Users/qaz14/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe",
    "-B",
    "-m",
    "unittest",
    "discover",
    "-s",
    "tests"
   ],
   "timeout_seconds": 1800,
   "max_stdout_bytes": 262144,
   "max_stderr_bytes": 262144
  }
 ],
 "required_test_profiles": [
  "python_unittest"
 ],
 "policy": {
  "policy_version": "policy-v1",
  "read_decision": "allow",
  "patch_decision": "deny",
  "test_decision": "allow",
  "principal_scopes": [
   "workspace.read",
   "sandbox.test"
  ]
 },
 "mcp_servers": [],
 "model_rounds": 120,
 "max_tool_calls": 250,
 "budget_action_limits": {
  "root": 250
 },
 "memory": {
  "request_context_soft_chars": 120000,
  "request_context_hard_chars": 176000,
  "request_context_reserve_chars": 24000,
  "compaction_target_chars": 96000,
  "in_run_keep_groups": 3,
  "max_compaction_epochs_per_run": 96,
  "max_compaction_source_groups": 96
 }
}